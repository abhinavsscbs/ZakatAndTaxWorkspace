OPENAI_API_KEY=
COHERE_API_KEY=
DEFAULT_PROVIDER=openai
OPENAI_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
COHERE_MODEL=command-a-03-2025
COHERE_EMBEDDING_MODEL=embed-v4.0
MAX_OUTPUT_TOKENS=128000
MAX_UPLOAD_MB=25
LOG_DIR=logs
DATA_DIR=data

# Local OCR, shared by both API variants
OCR_LANG=eng+ara
OCR_TIMEOUT_SECONDS=60
MAX_PDF_PAGES=100
TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Optional: leave unset for the model default. Some models reject custom values.
# OPENAI_TEMPERATURE=1

# Optional absolute path for a shared persistent dictionary file
# DICTIONARY_FILE=/absolute/path/replacement_dictionary.json
